<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Sightline</AssemblyName>
    <RootNamespace>Sightline</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- C6 SHIPS LIKE A PRODUCT — the build stamp a bug report can name. THIS LINE IS THE SINGLE
         SOURCE: Ship.Version reads it back off the assembly at runtime (never a hard-coded string
         that can drift from it) and the main-menu footer and pause card paint it. Bump it by hand
         when you cut a build. SIGHTLINE_SHIPTEST asserts it parses as MAJOR.MINOR.PATCH and that
         the string the HUD paints actually contains the assembly's own value. -->
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0</InformationalVersion>
    <!-- RESONANCE A2: Raylib.AttachAudioMixedProcessor takes a
         `delegate* unmanaged[Cdecl]<void*, uint, void>` (the master limiter in Audio.cs).
         Only that one callback needs it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="8.0.0" />
  </ItemGroup>

  <!-- Trimmed publish (see scripts/publish.sh + docs/DISTRIBUTION.md). Persistence itself is
       trim-proof by construction (source-generated JSON contexts in SaveGame/Display), but the
       SIGHTLINE_BALANCE telemetry export serialises anonymous types reflectively, which full trim
       would strip. Rooting our own assembly keeps that working; measured cost vs an unrooted trim
       is ~0 MB because the framework, not the game, is what trimming actually removes. -->
  <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimmerRootAssembly Include="Sightline" />
  </ItemGroup>
  <PropertyGroup Condition="'$(PublishTrimmed)' == 'true'">
    <!-- Trimming turns System.Text.Json's reflection fallback OFF by default; the telemetry
         export above needs it (it serialises anonymous types, which no source generator can see).
         Re-enabling it is only safe BECAUSE TrimmerRootAssembly keeps our metadata. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- Licence compliance: raylib + Raylib-cs (Zlib) and the .NET runtime (MIT) all require
         their notice be retained in distributions. Copied to the build/publish output so it
         travels with the binary. -->
    <None Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- C6: the project's OWN licence. docs/DISTRIBUTION.md §4 decided it (all rights reserved,
         explicitly NOT restricting compiled builds) and committed a root LICENSE — but nothing
         ever copied it into a build, so every distributable this repo has produced shipped the
         third-party notices and no statement of its own terms. A recipient of the zip could not
         tell what they were allowed to do with it. SIGHTLINE_SHIPTEST's manifest leg fails
         without this line. -->
    <None Include="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets/NotoMono-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets/NotoMono-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- RESONANCE V1 — display face for titles (Chakra Petch Bold, SIL OFL 1.1, 78 KB).
         OFL is zero-cost and zero-royalty, but it is NOT public domain: the licence text must
         ship alongside the font, and the font itself may not be sold on its own. Same footing
         the repo is already on with NotoMono. -->
    <None Include="assets/ChakraPetch-Bold.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets/ChakraPetch-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- HORIZON W7 — ship any dropped-in CC0 audio so the file-first/synth-fallback loader can
         actually find it at runtime (working dir = output dir; previously these were NOT copied,
         so a dropped-in file could never load). Globs match nothing until files are added, so this
         is a no-op on the current asset-free repo. Keep committed audio small (see assets/*/CREDITS.txt). -->
    <None Include="assets/sfx/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets/music/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ══ C6: THE PublishTrimmed HAZARD, AS A GUARD RATHER THAN A COMMENT ══════════════════════
       History (docs/DISTRIBUTION.md §3): a trimmed publish once compiled with 0 errors, booted,
       played and finished a whole autoplay campaign while saving NOTHING — no save.json, no meta
       profile — because reflection-based System.Text.Json lost the metadata trimming strips and
       the persistence layer's `catch { }` ate the exception. The mitigation is the two blocks
       above. Nothing enforced that they stayed: delete either one and the next trimmed publish is
       silently broken again, and only `scripts/publish.sh` (which a raw `dotnet publish` skips)
       would have caught it.
       This target makes the mitigation a BUILD ERROR to remove. It is deliberately narrow — it
       guards the two knobs, not the whole hazard. The other half of the hazard is "a new persisted
       DTO that no [JsonSerializable] root can see", which MSBuild cannot possibly know about;
       SIGHTLINE_SHIPTEST's source-generation leg covers that one, in the untrimmed build where
       everyone actually develops.

       WHAT EACH KNOB ACTUALLY PROTECTS — MEASURED, not inferred (C6 review, second reviewer).
       The first version of this target's error text said removing TrimmerRootAssembly meant a
       trimmed build "compiles clean, boots, plays a whole campaign and saves nothing". THAT IS
       FALSE TODAY and it is the sentence someone reads at their worst moment. Measured with the
       root removed and the reflection knob kept: SAVETEST PASSES and a run round-trips
       squad/perks/weapon-mods/card/heat correctly. With BOTH knobs removed: SAVETEST, METATEST and
       SHIPTEST all still PASS. **Player persistence is protected by SOURCE GENERATION ALONE** —
       that is the whole point of part (1) of the fix in docs/DISTRIBUTION.md section 3, and it
       works. The old sentence describes the PRE-source-generation failure and would send the next
       maintainer down the wrong road.
       What the two knobs actually keep alive is the SIGHTLINE_BALANCE telemetry export, the one
       remaining reflective site (it serialises anonymous types no generator can see). Measured
       failures there: root removed -> NotSupportedException ("parameter names have been trimmed by
       ILLink"); reflection knob removed -> InvalidOperationException ("Reflection-based
       serialization has been disabled"). Losing the flywheel silently is reason enough for a build
       error — this project's balance work runs on it — but say what breaks, not something worse. -->
  <Target Name="C6GuardTrimmedPersistence" BeforeTargets="Publish;PrepareForILLink"
          Condition="'$(PublishTrimmed)' == 'true'">
    <Error Condition="'$(JsonSerializerIsReflectionEnabledByDefault)' != 'true'"
           Text="TRIMMED PUBLISH GUARD: JsonSerializerIsReflectionEnabledByDefault is not true. Trimming turns System.Text.Json's reflection fallback off by default, which breaks the SIGHTLINE_BALANCE telemetry export (it serialises anonymous types no source generator can see): InvalidOperationException, 'Reflection-based serialization has been disabled for this application'. Save/meta persistence is NOT affected - it goes through source-generated contexts - but losing the balance flywheel silently is not acceptable either. See docs/DISTRIBUTION.md section 3." />
    <Error Condition="'@(TrimmerRootAssembly)' == ''"
           Text="TRIMMED PUBLISH GUARD: TrimmerRootAssembly is empty. Re-enabling the JSON reflection fallback above is only safe BECAUSE our own assembly is rooted; without it ILLink strips the metadata that fallback needs and the SIGHTLINE_BALANCE telemetry export throws NotSupportedException ('parameter names have been trimmed by ILLink'). Measured: save/meta persistence still works without this root (source-generated contexts), so this guards the flywheel, not the player's profile. See docs/DISTRIBUTION.md section 3." />
  </Target>

</Project>
